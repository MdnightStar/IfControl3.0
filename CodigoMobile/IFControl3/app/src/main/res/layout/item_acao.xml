<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imgIconAcao"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_light"
            android:padding="8dp"
            android:src="@drawable/icone_acao"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#003366" />

        <LinearLayout
            android:id="@+id/layoutDataHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textViewAcaoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#757575"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="25/12/24" />

            <TextView
                android:id="@+id/textViewAcaoHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                tools:text="14:35" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewAcaoDescricao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/layoutDataHora"
            app:layout_constraintStart_toEndOf="@+id/imgIconAcao"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Ligou o Ar Condicionado" />

        <TextView
            android:id="@+id/textViewAcaoSala"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#003366"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/textViewAcaoDescricao"
            app:layout_constraintStart_toStartOf="@+id/textViewAcaoDescricao"
            app:layout_constraintTop_toBottomOf="@+id/textViewAcaoDescricao"
            tools:text="Sala: 15" />

        <TextView
            android:id="@+id/textViewAcaoUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:textColor="#546E7A"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/textViewAcaoId"
            app:layout_constraintStart_toStartOf="@+id/textViewAcaoDescricao"
            app:layout_constraintTop_toBottomOf="@+id/textViewAcaoSala"
            tools:text="Login: professor.javier" />

        <TextView
            android:id="@+id/textViewAcaoId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#BDBDBD"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutDataHora"
            app:layout_constraintVertical_bias="1.0"
            tools:text="#1045" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
